{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "AUTH_FAILED",
            "AUTH_EXPIRED",
            "SCOPE_DENIED",
            "CONSENT_REQUIRED",
            "PERMISSION_DENIED",
            "RISK_PAUSED",
            "TARGET_STALE",
            "LOW_CONFIDENCE",
            "NEED_TIME_CONFIRMATION",
            "VERSION_CONFLICT",
            "RATE_LIMITED",
            "PROVIDER_UNAVAILABLE",
            "CANCELLED",
            "TIMEOUT",
            "NETWORK_OFFLINE",
            "STREAM_INTERRUPTED",
            "INVALID_REQUEST",
            "PARTIAL_FAILURE",
            "INVITE_EXPIRED"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    }
  },
  "required": [
    "request_id",
    "schema_version",
    "error"
  ]
}
