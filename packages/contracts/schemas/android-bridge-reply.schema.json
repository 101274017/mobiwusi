{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "platform",
        "externalCapture",
        "nativeOverlay",
        "remoteMedia",
        "status"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "platform": {
          "const": "android"
        },
        "externalCapture": {
          "const": false
        },
        "nativeOverlay": {
          "const": false
        },
        "remoteMedia": {
          "const": false
        },
        "status": {
          "const": "native-skeleton"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "stopped",
        "captureActive"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "stopped": {
          "const": true
        },
        "captureActive": {
          "const": false
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "outcome",
        "status",
        "reason"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "enum": [
            "created",
            "replaced",
            "idempotent"
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "status",
        "reason"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "cancelled",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "status",
        "reason"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "status": {
          "enum": [
            "submitted",
            "not_due",
            "not_found",
            "not_scheduled",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "generation",
        "error_code",
        "message"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error_code": {
          "enum": [
            "bridge_error",
            "storage_error",
            "scheduler_error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  ]
}
