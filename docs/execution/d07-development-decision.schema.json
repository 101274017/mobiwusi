{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedBy", "generatedAt", "decisionId", "decision", "decisionMode", "reviewType", "review_type", "development", "release", "inputFingerprint", "idempotencyKey", "limitations"],
  "properties": {
    "schemaVersion": { "const": "d07-decision/v2" },
    "generatedBy": { "const": "nuanban/scripts/check-d07-decision.mjs" },
    "generatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*(?:Z|[+-]\\d{2}:\\d{2})$" },
    "decisionId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["go", "no_go"] },
    "decisionMode": { "const": "development" },
    "reviewType": { "const": "automated" },
    "review_type": { "const": "automated" },
    "inputFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idempotencyKey": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "development": {
      "type": "object",
      "required": ["verdict", "eligible", "evidenceRefs", "externalPending"],
      "properties": {
        "verdict": { "enum": ["DEV_READY", "DEV_READY_WITH_EXTERNAL_PENDING", "DEV_BLOCKED"] },
        "eligible": { "type": "boolean" },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "externalPending": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "capability", "reason", "production_enabled"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "capability": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "production_enabled": { "const": false }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "required": ["verdict", "ready", "reasonRefs", "formalDecision"],
      "properties": {
        "verdict": { "enum": ["NOT_ASSESSED", "EXTERNAL_PENDING", "BLOCKED", "READY"] },
        "ready": { "type": "boolean" },
        "reasonRefs": { "type": "array", "items": { "type": "string" } },
        "formalDecision": { "enum": ["go", "no_go", null] }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
