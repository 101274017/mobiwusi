{
  "name": "nuanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @nuanban/web dev",
    "server:dev": "pnpm --filter @nuanban/server start",
    "build": "pnpm typecheck && pnpm --filter @nuanban/web build && pnpm desktop:avatar:build",
    "desktop:avatar:build": "vite build --config apps/desktop/vite.avatar.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:evidence": "node scripts/run-unit-evidence.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test:evidence && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check && node scripts/validate-contracts.mjs",
    "contracts:kotlin:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-kotlin-contracts.ps1",
    "desktop": "pnpm build && pnpm --filter @nuanban/desktop start",
    "desktop:client": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop-client.ps1 -CompatibleDisplay",
    "desktop:lili": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-lili-desktop.ps1",
    "desktop:lili:check": "node scripts/test-lili-desktop.mjs",
    "desktop:artwork:check": "node scripts/check-local-artwork-desktop.mjs",
    "desktop:model:check": "node scripts/check-local-model-desktop.mjs",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-package.ps1",
    "desktop:lab": "node scripts/desktop-lab.mjs --open",
    "desktop:lab:check": "node scripts/desktop-lab.mjs --self-test",
    "desktop:lab:package": "node scripts/desktop-lab.mjs --package",
    "privacy:c03:check": "vitest run tests/privacy/c03-gate.test.ts --reporter=json --outputFile=docs/implementation/evidence/privacy-c03-results.json && node scripts/annotate-vitest-evidence.mjs --file docs/implementation/evidence/privacy-c03-results.json",
    "media:c04:check": "vitest run tests/privacy/c04-media-relay.test.ts --reporter=json --outputFile=docs/implementation/evidence/media-c04-results.json && node scripts/annotate-vitest-evidence.mjs --file docs/implementation/evidence/media-c04-results.json",
    "guidance:c05:c06:check": "vitest run tests/domain/guidance-platform.test.ts --reporter=json --outputFile=docs/implementation/evidence/guidance-c05-c06-results.json",
    "reminder:c07:c08:check": "vitest run tests/domain/reminder-engine.test.ts tests/domain/reminder-dispatch.test.ts tests/platform/native-host.test.ts --reporter=json --outputFile=docs/implementation/evidence/reminder-c07-c08-results.json",
    "reminder:runtime:check": "vitest run tests/platform/reminder-runtime.test.ts --reporter=json --outputFile=docs/implementation/evidence/reminder-runtime-results.json",
    "pet:c13:check": "vitest run tests/domain/pet-asset-quality.test.ts --reporter=json --outputFile=docs/implementation/evidence/pet-c13-results.json",
    "c11:3d:check": "vitest run tests/domain/three-d-asset-preflight.test.ts --reporter=json --outputFile=docs/implementation/evidence/c11-3d-results.json",
    "c12:sandbox:check": "vitest run tests/provider/provider-sandbox.test.ts --reporter=json --outputFile=docs/implementation/evidence/c12-sandbox-results.json",
    "c15:nv:check": "node scripts/check-c15-nv-readiness.mjs --evidence docs/implementation/evidence/c15-nv-readiness-results.json",
    "c16:decision:check": "node scripts/check-c16-decision-readiness.mjs --evidence docs/implementation/evidence/c16-decision-readiness-results.json",
    "d07:decision:check": "node scripts/check-d07-decision.mjs --decision docs/implementation/evidence/d07-decision.json",
    "d07:release:check": "node scripts/check-d07-decision.mjs --mode release --no-write",
    "release:readiness:check": "node scripts/check-release-readiness.mjs",
    "tasks:refresh": "node scripts/generate-ef-execution-cards.mjs --refresh",
    "e:development:check": "node scripts/check-e-development.mjs",
    "c17:assembly:check": "node scripts/check-c17-assembly.mjs --evidence docs/implementation/evidence/c17-assembly-results.json",
    "d:gate:check": "node scripts/check-d-gate-readiness.mjs --evidence docs/implementation/evidence/d-gate-readiness-results.json",
    "acceptance:check": "node scripts/check-acceptance-bundle.mjs --evidence docs/implementation/evidence/acceptance-bundle-results.json",
    "f:development:check": "node scripts/check-f-development.mjs",
    "f:development:matrix": "node scripts/f-development/dependency-matrix.mjs",
    "f:development:run": "node scripts/run-f-development.mjs",
    "f:development:execute": "node scripts/f-development/execute.mjs",
    "localdata:c07:c08:check": "vitest run tests/integration/c07-c08-reminder-store.test.ts --reporter=json --outputFile=docs/implementation/evidence/localdata-c07-c08-results.json",
    "sqlite:c07:c08:check": "node apps/desktop/native-lab/c07-c08-sqlite-preflight.mjs --evidence docs/implementation/evidence/sqlite-c07-c08-results.json",
    "desktop:reminder-store:check": "vitest run tests/platform/desktop-reminder-store.test.ts --reporter=json --outputFile=docs/implementation/evidence/desktop-reminder-store-results.json",
    "desktop:notification:check": "vitest run tests/platform/desktop-notification-adapter.test.ts tests/platform/desktop-reminder-bridge.test.ts --reporter=json --outputFile=docs/implementation/evidence/desktop-notification-adapter-results.json",
    "lifecycle:c09:c10:check": "vitest run tests/platform/native-host.test.ts tests/platform/lifecycle-engine.test.ts tests/platform/desktop-lifecycle.test.ts --reporter=json --outputFile=docs/implementation/evidence/lifecycle-c09-c10-results.json",
    "c14:handoff:check": "node scripts/check-c14-handoff.mjs --evidence docs/implementation/evidence/c14-handoff-results.json",
    "android:sync": "pnpm build && node scripts/sync-android.mjs",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1",
    "android:room:check": "node scripts/check-android-room.mjs --evidence docs/implementation/evidence/android-room-results.json",
    "android:room:jvm:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-reminder-transition-jvm.ps1 -EvidencePath docs/implementation/evidence/android-room-jvm-results.json",
    "android:lab:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 -NativeLab",
    "android:lab:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-android-lab.ps1",
    "android:lab:evidence": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/record-android-lab-evidence.ps1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "typescript": "5.9.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.5",
    "ajv": "8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/node": "24.10.0"
  }
}
